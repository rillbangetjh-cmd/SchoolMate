<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and higher. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="schoolmate.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="schoolmate.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
